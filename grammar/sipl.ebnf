(* SIPL — SImple Programming Language. Language version 1.0 (toolkit 0.4.0)

   Ця граматика точно відповідає БНФ SIPL з матеріалів курсу:
     О.В. Шишацька, А.В. Криволап, А.В. Шишацький. «Теорія програмування. Практикум», 2024, ПР 1;
     М.С. Нікітченко. «Теорія програмування», 2020.
   Машинозчитувана форма, яку використовує парсер: src/sipl/grammar/sipl.lark.
   tests/test_grammar.py перевіряє її на 28 коректних і 43 некоректних програмах.

   ---------- БНФ курсу (джерело) ----------
   P ::= begin S end                                                        (P1)
   S ::= x := a | S1 ; S2 | if b then S1 else S2 | while b do S
       | begin S end | skip                                                 (S1–S6)
   a ::= n | x | a1 + a2 | a1 - a2 | a1 * a2 | (a)                          (A1–A6)
   b ::= a1 = a2 | a1 > a2 | b1 ∨ b2 | ¬b | (b)                             (B1–B5)
   x ::= ... | M | N | ...         n ::= ... | -1 | 0 | 1 | ...

   БНФ неоднозначна (не задає пріоритетів і меж S1 ; S2), тому нижче вона записана
   у рівносильній однозначній формі. Мова (множина програм) не змінюється. *)

program     = "begin" , seq , "end" ;                                   (* P1 *)

seq         = stmt , { ";" , stmt } ;                     (* S2: S1 ; S2, ліва асоціативність *)
stmt        = assign | if_stmt | while_stmt | block | skip_stmt ;
assign      = NAME , ":=" , aexp ;                                       (* S1 *)
if_stmt     = "if" , bexp , "then" , seq , "else" , stmt ;               (* S3 *)
while_stmt  = "while" , bexp , "do" , stmt ;                             (* S4 *)
block       = "begin" , seq , "end" ;                                    (* S5 *)
skip_stmt   = "skip" ;                                                   (* S6 *)

(* Межі операторів (як у Pascal): then-гілка обмежена словом else, тож може бути
   послідовністю; else-гілка і тіло while — один оператор, а ';' після них завершує
   весь if/while. Кілька операторів у тілі циклу записуються через begin ... end. *)

aexp        = term , { ( "+" | "-" ) , term } ;                          (* A3, A4 *)
term        = factor , { "*" , factor } ;                                (* A5 *)
factor      = num                                                        (* A1 *)
            | NAME                                                       (* A2 *)
            | "(" , aexp , ")" ;                                         (* A6 *)
num         = [ "-" ] , NUMBER ;                       (* n — ціле, можливо від'ємне: -1 *)

(* Пріоритет: * вище за + і -; усі бінарні операції лівоасоціативні.
   Мінус перед змінною або дужками (-X) не входить до мови: пишіть 0 - X. *)

bexp        = bterm , { OR , bterm } ;                                   (* B3 *)
bterm       = NOT , bterm | bfactor ;                                    (* B4 *)
bfactor     = aexp , "=" , aexp                                          (* B1 *)
            | aexp , ">" , aexp                                          (* B2 *)
            | "(" , bexp , ")" ;                                         (* B5 *)

(* Пріоритет: ¬ вище за ∨. *)

(* ---------- Лексика ---------- *)

OR          = "or" | "∨" ;
NOT         = "not" | "¬" ;
NAME        = letter , { letter | digit | "_" } - keyword ;              (* x *)
letter      = "A".."Z" | "a".."z" ;
NUMBER      = digit , { digit } ;
digit       = "0".."9" ;
keyword     = "begin" | "end" | "if" | "then" | "else" | "while" | "do" | "skip"
            | "or" | "not" ;

(* Пробіли й переведення рядка ігноруються. Коментарі `// ...` та `/* ... */` —
   зручність інструментів (не частина БНФ): вони відкидаються лексером і не
   потрапляють у дерево виводу.

   Чого в SIPL НЕМАЄ (парсер відхиляє з підказкою): ділення / і остачі %,
   порівнянь < <= >= <> !=, кон'юнкції and, літералів true/false, унарного
   мінуса перед змінною, програми без зовнішнього begin ... end. *)

(* ---------- Семантика (неформально; реалізація: src/sipl/interpreter) ----------
   Стан — часткове відображення змінних у цілі числа (необмеженої розрядності).
   x := a       — обчислює a у поточному стані й оновлює x.
   S1 ; S2      — послідовне виконання (композиція).
   if / while   — умова обчислюється в поточному стані.
   b1 ∨ b2      — обчислюються обидва операнди (строга диз'юнкція).
   Невизначеність: читання змінної, якої немає у стані (помилка виконання);
   незавершення циклу обмежується лімітом кроків. *)
